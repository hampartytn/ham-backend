NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# PostgreSQL 18. Copy host, port, and username from pgAdmin → server → Properties → Connection.
# Local PostgreSQL 18 is commonly port 5433 (17 is often 5432). Database name: ham_backend.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/ham_backend?schema=public

JWT_ACCESS_SECRET=replace-with-long-random-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-different-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=14d
JWT_REFRESH_COOKIE_ENABLED=false

CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Development: true. Production default is false unless SWAGGER_ENABLED=true
# (and then SWAGGER_USER + SWAGGER_PASSWORD are required).
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_USER=
SWAGGER_PASSWORD=

LOG_LEVEL=info
# `otp` is redacted in structured JSON fields. Mock OTP uses a plain warn banner
# plus `logs/mock-otp.log` in non-production (see MockSmsProvider).
LOG_REDACT=password,passwordHash,accessToken,refreshToken,authorization,aadhaar,otp,secret,cardNumber

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10

IDENTITY_PROVIDER=mock
IDENTITY_WEBHOOK_SECRET=replace-with-identity-webhook-secret-min-32chars
HAM_MEMBERSHIP_TERMS_VERSION=ham-membership-2026-08
SMS_PROVIDER=mock
EMAIL_PROVIDER=stub
PAYMENT_PROVIDER=stub
PAYMENT_STUB_ENABLED=true
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret-min-32chars
PAYMENT_EMPLOYER_ACTIVATION_PAISE=1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_DIR=./storage
FILE_MAX_BYTES=2097152

SEED_DEV_ADMIN=false
SEED_DEV_ADMIN_PHONE=
SEED_DEV_ADMIN_PASSWORD=
